# Backend
APP_ENV=development
# Local dev without Docker (SQLite):
DATABASE_URL=sqlite+pysqlite:///./uploadsaathi.db
# With Docker Compose (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://uploadsaathi:uploadsaathi@db:5432/uploadsaathi
# A hosted `postgres://…` URL is accepted as-is; it is rewritten to psycopg 3 automatically.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth — MUST be set to a long random value in any deployed environment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me

# Where prepared documents are written. Originals are never stored.
STORAGE_DIR=./var/documents
# Uploads larger than this are refused before any processing (25 MB locally, less on small hosts).
MAX_UPLOAD_BYTES=26214400

# Postgres (used by docker-compose)
POSTGRES_USER=uploadsaathi
POSTGRES_PASSWORD=uploadsaathi
POSTGRES_DB=uploadsaathi

# Frontend
# Left unset in local dev: the Vite proxy forwards /api to the backend.
# In a hosted build, set it to the deployed API, including the version prefix:
# VITE_API_BASE_URL=https://uploadsaathi-api.onrender.com/api/v1
